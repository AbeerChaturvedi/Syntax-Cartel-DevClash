root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,jsx,ts,tsx,mjs,cjs}]
indent_size = 2

[*.{yml,yaml,json,md}]
indent_size = 2

[*.{sh,bash}]
end_of_line = lf

[*.md]
trim_trailing_whitespace = false
